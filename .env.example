# Copy this to .env and add your API keys
# This file is NOT committed to git for security

# OpenAI API Key (for better speech recognition accuracy)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Database configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=aura_db

# Optional: Email configuration for AURA to send emails
# You need: Gmail Account + App Password (not regular password)
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Optional: same settings with AURA_ prefix (either form works)
AURA_SENDER_EMAIL=your-email@gmail.com
AURA_SENDER_APP_PASSWORD=your-app-password
AURA_SMTP_SERVER=smtp.gmail.com
AURA_SMTP_PORT=587

# Optional: enterprise admin roles (comma-separated emails)
# Users in this list can run restricted high-risk system commands.
AURA_ADMIN_EMAILS=admin@yourcompany.com
